package web

import "strconv"

templ layout(title, active string, inbox int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Budgeteer</title>
			<link rel="icon" href="data:,"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body class="min-h-screen bg-base-200 text-base-content">
			<header class="navbar bg-base-100 border-b border-base-300 px-4 flex-wrap gap-y-2">
				<a href="/" class="text-lg font-semibold mr-6">Budgeteer</a>
				<nav class="flex flex-wrap gap-1">
					@navLink("/", "Overview", active == "overview")
					<a href="/inbox" class={ "btn btn-sm", templ.KV("btn-neutral", active == "inbox"), templ.KV("btn-ghost", active != "inbox") }>
						Inbox
						<span id="inbox-count" class={ "badge badge-sm", templ.KV("badge-primary", inbox > 0), templ.KV("badge-ghost", inbox == 0) }>{ strconv.Itoa(inbox) }</span>
					</a>
					@navLink("/transactions", "Transactions", active == "transactions")
					@navLink("/categories", "Categories", active == "categories")
					@navLink("/import", "Import", active == "import")
				</nav>
			</header>
			<main class="mx-auto max-w-7xl p-4">
				{ children... }
			</main>
		</body>
	</html>
}

templ navLink(href, label string, current bool) {
	<a href={ templ.SafeURL(href) } class={ "btn btn-sm", templ.KV("btn-neutral", current), templ.KV("btn-ghost", !current) }>{ label }</a>
}
